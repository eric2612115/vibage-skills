#!/usr/bin/env bash
# Sample soft hook for child repos (optional). Install into .git/hooks/post-commit.
# Missing hook ≠ bypass mother HARD_MOTHER gates.
set -euo pipefail
echo "VIBAGE_FRESHNESS_ASK: Mother hub may be stale for this repo. Update docs/vibage map/matrix/progress now? [yes/no]"
# Best-effort child warn if PKG_ROOT resolvable (same probe order as resolve-pkg-root.sh).
# Never hardcode a developer machine path (e.g. ~/MindOwnBuz/...).
HERE="$(pwd)"
PKG_ROOT="${VIBAGE_PKG_ROOT:-}"
if [[ -z "$PKG_ROOT" && -n "${HOME:-}" ]]; then
  for home in \
    "$HOME/.cursor/skills" \
    "$HOME/.claude/skills" \
    "$HOME/.agents/skills"; do
    for name in vibage-init vibage-issue-locate vibage-locate; do
      cand="$home/$name"
      [[ -e "$cand" ]] || continue
      resolved="$(cd "$(dirname "$(realpath "$cand")")/../.." 2>/dev/null && pwd)" || true
      if [[ -n "${resolved:-}" && -x "$resolved/scripts/freshness-check.sh" ]]; then
        PKG_ROOT="$resolved"
        break 2
      fi
    done
  done
fi
if [[ -n "${PKG_ROOT:-}" && -x "$PKG_ROOT/scripts/freshness-check.sh" ]]; then
  bash "$PKG_ROOT/scripts/freshness-check.sh" --mode=child "$HERE" || true
fi
